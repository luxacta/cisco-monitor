# Cisco DevNet Sandbox credentials
# 1. Go to https://devnetsandbox.cisco.com
# 2. Launch "Catalyst 9000 Always-On" (or Catalyst 8000 Always-On)
# 3. Copy the unique username + password shown in the portal
# 4. Paste them below (do NOT use shared/old credentials)

# Cat 9000 Always-On hostname:
CISCO_HOST=devnetsandboxiosxec9k.cisco.com
# Cat 8000 Always-On hostname (alternative):
# CISCO_HOST=devnetsandboxiosxec8k.cisco.com

CISCO_PORT=443
CISCO_USERNAME=your_unique_username_from_portal
CISCO_PASSWORD=your_unique_password_from_portal

# Polling interval in milliseconds (default 3000)
POLL_INTERVAL_MS=3000
